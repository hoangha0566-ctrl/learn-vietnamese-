  "grammar": [
    {
      "pattern": "S + bị + bệnh / việc không may",
      "explainVi": "“bị” dùng khi người nói thấy sự việc là không tốt, không may.",
      "explainEn": "“bị” is used when the event is bad or unfortunate for the subject.",
      "examples": [
        { "vi": "Tôi bị cảm.", "en": "I have a cold." },
        { "vi": "Anh ấy bị phạt.", "en": "He was fined." },
        { "vi": "Chị Lan bị mất xe.", "en": "Lan had her motorbike stolen." }
      ],
      "note": "Hỏi: Anh bị sao vậy? / Anh bị làm sao? (What's wrong with you?)"
    },
    {
      "pattern": "S + được + việc tốt",
      "explainVi": "“được” dùng khi sự việc là tốt, có lợi cho chủ ngữ.",
      "explainEn": "“được” is used when the event is good or beneficial for the subject.",
      "examples": [
        { "vi": "Tôi được nghỉ hai ngày.", "en": "I got two days off." },
        { "vi": "Em được cô giáo khen.", "en": "I was praised by the teacher." }
      ],
      "note": ""
    },
    {
      "pattern": "S + nên + V",
      "explainVi": "Dùng “nên” để khuyên.",
      "explainEn": "Use “nên” (should) to give advice.",
      "examples": [
        { "vi": "Anh nên đi bác sĩ.", "en": "You should see a doctor." },
        { "vi": "Chị nên nghỉ ngơi.", "en": "You should rest." }
      ],
      "note": "Phủ định: không nên (shouldn't)."
    },
    {
      "pattern": "Hình như … rồi, phải không?",
      "explainVi": "“hình như” = có vẻ như, chưa chắc chắn.",
      "explainEn": "“hình như” = it seems that (not sure).",
      "examples": [{ "vi": "Hình như anh bị cảm rồi, phải không?", "en": "You seem to have a cold, right?" }],
      "note": ""
    }
  ],
