  "grammar": [
    {
      "pattern": "mấy vs bao nhiêu",
      "explainVi": "“Mấy”: số lượng người nói nghĩ là ít (thường dưới 10). “Bao nhiêu”: không biết nhiều hay ít.",
      "explainEn": "“mấy”: quantity assumed small (usually under 10). “bao nhiêu”: size unknown.",
      "examples": [
        {
          "vi": "Lớp anh có mấy người? – 5 người.",
          "en": "How many people in your class? – 5."
        },
        {
          "vi": "Công ty anh có bao nhiêu nhân viên?",
          "en": "How many employees does your company have?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "quá vs rất",
      "explainVi": "“Quá” dùng trong câu cảm thán, thường đứng sau tính từ. “Rất” dùng trong câu trần thuật, đứng trước tính từ.",
      "explainEn": "“quá” = exclamation, usually after the adjective. “rất” = statement, before the adjective.",
      "examples": [
        {
          "vi": "Cô nói tiếng Việt hay quá!",
          "en": "You speak Vietnamese so well!"
        },
        {
          "vi": "Cô ấy nói tiếng Việt rất giỏi.",
          "en": "She speaks Vietnamese very well."
        }
      ],
      "note": ""
    },
    {
      "pattern": "đâu vs ở đâu",
      "explainVi": "“Đi đâu?” hỏi hướng di chuyển. “Ở đâu?” dùng sau làm việc, học, sống… để hỏi vị trí.",
      "explainEn": "“đi đâu?” asks about destination. “ở đâu?” follows làm việc, học, sống… to ask location.",
      "examples": [
        {
          "vi": "Chị đi đâu đấy?",
          "en": "Where are you going?"
        },
        {
          "vi": "Anh làm việc ở đâu?",
          "en": "Where do you work?"
        }
      ],
      "note": ""
    }
  ],
  "dialogues": [
    {
      "title": "Ở quán cà phê",
      "titleEn": "At a café",
      "lines": [
        {
          "speaker": "Ana",
          "vi": "Xin lỗi, tôi ngồi đây được không ạ?",
          "en": "Excuse me, may I sit here?"
        },
        {
          "speaker": "Bảo",
          "vi": "Dạ, được. Mời chị. Chị nói tiếng Việt hay quá! Chị học tiếng Việt ở đâu?",
          "en": "Yes, please. You speak Vietnamese so well! Where do you study?"
        },
        {
          "speaker": "Ana",
          "vi": "Tôi học ở Trường Đại học Khoa học Xã hội và Nhân văn.",
          "en": "I study at the University of Social Sciences and Humanities."
        },
        {
          "speaker": "Bảo",
          "vi": "Lớp chị có mấy người?",
          "en": "How many people are in your class?"
        },
        {
          "speaker": "Ana",
          "vi": "Có sáu người. Còn anh, anh làm việc ở đâu?",
          "en": "Six. And where do you work?"
        },
        {
          "speaker": "Bảo",
          "vi": "Tôi làm ở một công ty máy tính. Công ty tôi có khoảng ba trăm nhân viên.",
          "en": "I work at a computer company. It has about 300 staff."
        }
      ]
    },
