  "grammar": [
    {
      "pattern": "Địa chỉ: số nhà → đường → phường → quận → thành phố",
      "explainVi": "Địa chỉ ở thành phố Việt Nam viết theo thứ tự từ nhỏ đến lớn.",
      "explainEn": "Vietnamese city addresses go from smallest to largest unit.",
      "examples": [
        {
          "vi": "Nhà tôi ở số 50, đường Nguyễn Thị Diệu, Phường 6, Quận 3, TP. Hồ Chí Minh.",
          "en": "My house is at 50 Nguyễn Thị Diệu Street, Ward 6, District 3, HCMC."
        }
      ],
      "note": ""
    },
    {
      "pattern": "V (+ O) + được (không)?",
      "explainVi": "“được” chỉ khả năng, đứng sau động từ chính (trước hoặc sau tân ngữ). Phủ định: không + V + được.",
      "explainEn": "“được” = ability, after the main verb (before or after the object). Negative: không + V + được.",
      "examples": [
        {
          "vi": "Cô nói tiếng Anh được không?",
          "en": "Can you speak English?"
        },
        {
          "vi": "Tôi không nói được tiếng Pháp.",
          "en": "I can't speak French."
        },
        {
          "vi": "– Dạ, được. / – Dạ, không được.",
          "en": "– Yes, I can. / – No, I can't."
        }
      ],
      "note": ""
    },
    {
      "pattern": "S + V + để + V (mục đích)",
      "explainVi": "“để” nối hành động với mục đích. Hỏi: … để làm gì?",
      "explainEn": "“để” links an action to its purpose. Question: … để làm gì?",
      "examples": [
        {
          "vi": "Cô đến Việt Nam để làm gì?",
          "en": "Why did you come to Vietnam?"
        },
        {
          "vi": "Tôi đến Việt Nam để học tiếng Việt.",
          "en": "I came to Vietnam to study Vietnamese."
        }
      ],
      "note": ""
    },
    {
      "pattern": "đã + V",
      "explainVi": "“đã” chỉ việc xảy ra trước thời điểm nói. Có từ chỉ thời gian thì có thể bỏ “đã”.",
      "explainEn": "“đã” marks something before now. Can be dropped when a time word is present.",
      "examples": [
        {
          "vi": "Cô Mai đã học tiếng Anh 2 năm.",
          "en": "Mai has studied English for two years."
        },
        {
          "vi": "Hôm qua tôi đi thư viện.",
          "en": "Yesterday I went to the library."
        }
      ],
      "note": ""
    },
    {
      "pattern": "mấy",
      "explainVi": "Hỏi số lượng mà người nói nghĩ là ít (dưới 10), và hỏi số nhà, số điện thoại, giờ.",
      "explainEn": "Asks about a quantity assumed small (under 10), and about house/phone numbers, time.",
      "examples": [
        {
          "vi": "Chị đã học tiếng Anh mấy năm?",
          "en": "How many years have you studied English?"
        },
        {
          "vi": "Nhà anh ở quận mấy?",
          "en": "Which district is your house in?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "Số đếm",
      "explainVi": "Lưu ý: 15 = mười lăm, 21 = hai mươi mốt, 25 = hai mươi lăm, 150 = một trăm rưỡi, 205 = hai trăm lẻ/linh năm.",
      "explainEn": "Note: 15 = mười lăm, 21 = hai mươi mốt, 25 = hai mươi lăm, 150 = một trăm rưỡi, 205 = hai trăm lẻ/linh năm.",
      "examples": [
        {
          "vi": "Số điện thoại: ba – tám – hai – hai – năm – không – không – chín",
          "en": "Phone numbers are read digit by digit."
        }
      ],
      "note": ""
    },
    {
      "pattern": "xin",
      "explainVi": "Biểu thị thái độ khiêm tốn, lễ phép khi chào, cảm ơn, mời, yêu cầu.",
      "explainEn": "Shows humility and politeness when greeting, thanking, inviting or asking.",
      "examples": [
        {
          "vi": "Xin chào ông.",
          "en": "Hello, sir."
        },
        {
          "vi": "Xin cảm ơn bà.",
          "en": "Thank you, madam."
        }
      ],
      "note": ""
    }
  ],
