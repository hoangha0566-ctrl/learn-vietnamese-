  "grammar": [
    {
      "pattern": "S + làm nghề gì?",
      "explainVi": "Hỏi nghề nghiệp. Trả lời: S + là/làm + nghề.",
      "explainEn": "Ask about a job. Answer: S + là/làm + job.",
      "examples": [
        {
          "vi": "Anh làm nghề gì?",
          "en": "What do you do?"
        },
        {
          "vi": "Tôi là bác sĩ. / Tôi làm bác sĩ.",
          "en": "I'm a doctor."
        }
      ],
      "note": ""
    },
    {
      "pattern": "S + làm việc ở + nơi chốn",
      "explainVi": "“ở” chỉ nơi chốn. “ở” cũng là động từ: Xe hơi ở đằng kia.",
      "explainEn": "“ở” marks place. It is also a verb “to be (located)”.",
      "examples": [
        {
          "vi": "Chị ấy làm việc ở bệnh viện.",
          "en": "She works at a hospital."
        },
        {
          "vi": "Xe hơi ở đằng kia.",
          "en": "The car is over there."
        }
      ],
      "note": ""
    },
    {
      "pattern": "S + đang + V",
      "explainVi": "“đang” chỉ hành động đang diễn ra.",
      "explainEn": "“đang” marks an action in progress.",
      "examples": [
        {
          "vi": "Tôi đang ăn cơm.",
          "en": "I am eating."
        },
        {
          "vi": "Chị đang đợi ai đấy?",
          "en": "Who are you waiting for?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "… đấy?",
      "explainVi": "Trợ từ cuối câu, hành động đang diễn ra. Có thể thay bằng đó, vậy, thế.",
      "explainEn": "Final particle for an action in progress. Can be replaced by đó, vậy, thế.",
      "examples": [
        {
          "vi": "Anh đi đâu đấy?",
          "en": "Where are you going?"
        },
        {
          "vi": "Chị đang làm gì đấy?",
          "en": "What are you doing?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "… ạ",
      "explainVi": "Trợ từ cuối câu, biểu thị kính trọng, lịch sự.",
      "explainEn": "Final particle expressing respect and politeness.",
      "examples": [
        {
          "vi": "Ông có mệt không ạ?",
          "en": "Are you tired, sir?"
        },
        {
          "vi": "Dạ, cháu là sinh viên ạ.",
          "en": "I'm a student (polite)."
        }
      ],
      "note": ""
    }
