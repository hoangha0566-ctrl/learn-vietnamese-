  "grammar": [
    {
      "pattern": "Hỏi đường",
      "explainVi": "Xin lỗi, (anh/chị) làm ơn cho hỏi: … ở đâu? / … có gần đây không?",
      "explainEn": "Polite: Excuse me, may I ask: where is …? / Is … near here?",
      "examples": [
        {
          "vi": "Xin lỗi, chị làm ơn cho hỏi: bưu điện ở đâu ạ?",
          "en": "Excuse me, where is the post office?"
        },
        {
          "vi": "Chợ Bến Thành có gần đây không ạ?",
          "en": "Is Bến Thành Market near here?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "Chỉ đường",
      "explainVi": "Đi thẳng … Đến ngã tư thì rẽ trái/phải. … ở bên trái/bên phải/đối diện …",
      "explainEn": "Go straight … At the crossroads turn left/right. … is on the left/right/opposite …",
      "examples": [
        {
          "vi": "Anh đi thẳng đường này. Đến ngã tư thì rẽ trái. Bưu điện ở bên phải.",
          "en": "Go straight on this street. At the crossroads turn left. The post office is on the right."
        }
      ],
      "note": ""
    },
    {
      "pattern": "không … (lắm) đâu",
      "explainVi": "Phủ định để thuyết phục hoặc bác bỏ ý kiến người nghe.",
      "explainEn": "Negation used to persuade or reject the listener's opinion.",
      "examples": [
        {
          "vi": "Không xa lắm đâu.",
          "en": "It's not very far at all."
        },
        {
          "vi": "Anh ấy không đến đâu.",
          "en": "He won't come (believe me)."
        }
      ],
      "note": ""
    },
    {
      "pattern": "adj + lắm",
      "explainVi": "“Lắm” chỉ mức độ cao, dùng trong khẩu ngữ. Trong câu phủ định dùng “lắm” thay cho “rất/quá”.",
      "explainEn": "“lắm” = very, in speech. In negatives use “không … lắm” instead of “rất/quá”.",
      "examples": [
        {
          "vi": "Nhà tôi ở xa lắm.",
          "en": "My house is very far."
        },
        {
          "vi": "Không xa lắm.",
          "en": "Not very far."
        }
      ],
      "note": ""
    },
    {
      "pattern": "mới + V",
      "explainVi": "Việc vừa xảy ra không lâu.",
      "explainEn": "Something that just happened.",
      "examples": [
        {
          "vi": "Tôi mới hỏi một người.",
          "en": "I just asked someone."
        },
        {
          "vi": "Cô Mai mới đi Hà Nội hôm qua.",
          "en": "Mai just went to Hà Nội yesterday."
        }
      ],
      "note": ""
    },
    {
      "pattern": "V + đi!",
      "explainVi": "Cuối câu: mệnh lệnh hoặc đề nghị (khẩu ngữ).",
      "explainEn": "At the end: command or suggestion (spoken).",
      "examples": [
        {
          "vi": "Chị nói đi!",
          "en": "Go ahead, speak!"
        },
        {
          "vi": "Mình kêu xích lô đi!",
          "en": "Let's call a cyclo!"
        }
      ],
      "note": ""
    },
    {
      "pattern": "… hả?",
