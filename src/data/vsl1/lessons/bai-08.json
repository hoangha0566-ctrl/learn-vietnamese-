  "dialogues": [
    {
      "title": "Hỏi đường đến bưu điện",
      "titleEn": "Asking the way to the post office",
      "lines": [
        {
          "speaker": "Emma",
          "vi": "Xin lỗi, anh làm ơn cho hỏi: bưu điện ở đâu ạ?",
          "en": "Excuse me, where is the post office?"
        },
        {
          "speaker": "Người đi đường",
          "vi": "Chị đi thẳng đường này. Đến ngã tư thì rẽ phải. Bưu điện ở bên trái.",
          "en": "Go straight. At the crossroads turn right. It's on the left."
        },
        {
          "speaker": "Emma",
          "vi": "Đi thẳng, rồi rẽ phải hả anh? Có xa không?",
          "en": "Straight, then right? Is it far?"
        },
        {
          "speaker": "Người đi đường",
          "vi": "Không xa lắm đâu. Khoảng 300 mét thôi.",
          "en": "Not far at all. Only about 300 metres."
        },
        {
          "speaker": "Emma",
          "vi": "Nhưng tôi mới hỏi một người. Người đó nói là xa lắm.",
          "en": "But I just asked someone. They said it was very far."
        },
        {
          "speaker": "Người đi đường",
          "vi": "Không phải đâu. Chị đi đi, không lạc đâu.",
          "en": "No, it isn't. Go on, you won't get lost."
        }
      ]
    },
    {
      "title": "Túi nặng quá!",
      "titleEn": "The bag is so heavy!",
      "lines": [
        {
          "speaker": "Chồng",
          "vi": "Ôi, nặng quá! Mình đi xích lô đi, em.",
          "en": "Oh, it's so heavy! Let's take a cyclo."
        },
        {
          "speaker": "Vợ",
          "vi": "Chợ không xa lắm đâu. Đến ngã tư em hỏi cảnh sát.",
          "en": "The market isn't far. I'll ask the police at the crossroads."
        },
        {
          "speaker": "Vợ",
          "vi": "Dạ, anh làm ơn cho hỏi: chợ Bến Thành có gần đây không ạ?",
          "en": "Excuse me, is Bến Thành Market near here?"
        },
        {
          "speaker": "Cảnh sát",
          "vi": "Chợ Bến Thành hả? Chị đi thẳng, đến ngã tư thứ hai thì rẽ trái. Chợ ở đối diện khách sạn.",
          "en": "Bến Thành? Go straight, turn left at the second crossroads. It's opposite the hotel."
        }
      ]
    }
  ],
  "reading": {
    "title": "Khách sạn của tôi",
    "text": "Khách sạn tôi đang ở không xa trường lắm. Từ trường, tôi đi thẳng khoảng 200 mét, đến ngã tư thì rẽ phải. Khách sạn ở bên trái. Đối diện khách sạn là trạm xe buýt. Bên phải khách sạn là một tiệm ăn nhỏ. Buổi sáng tôi thường ăn sáng ở đó. Bên trái khách sạn là một nhà hàng lớn, nhưng bạn tôi nói là nhà hàng đó đắt lắm.",
