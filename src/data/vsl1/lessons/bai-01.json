  "grammar": [
    {
      "pattern": "S + tên là + tên",
      "explainVi": "“là” nối chủ ngữ với danh từ. Có thể bỏ “là”: Tôi tên Nam.",
      "explainEn": "“là” links the subject to a noun. It can be dropped: Tôi tên Nam.",
      "examples": [
        {
          "vi": "Tôi tên là Nam.",
          "en": "My name is Nam."
        },
        {
          "vi": "Tôi tên Nam.",
          "en": "My name is Nam."
        }
      ],
      "note": ""
    },
    {
      "pattern": "S + tên là gì?",
      "explainVi": "“gì” là từ để hỏi, đứng sau động từ hoặc sau “là”.",
      "explainEn": "“gì” (what) is placed after the verb or after “là”.",
      "examples": [
        {
          "vi": "Anh tên là gì?",
          "en": "What is your name?"
        },
        {
          "vi": "Cô tên là gì?",
          "en": "What is your name, Miss?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "Đại từ ngôi thứ hai: ông, bà, anh, chị, cô, thầy, em",
      "explainVi": "Chọn đại từ theo giới tính, tuổi tác và quan hệ giữa người nói và người nghe.",
      "explainEn": "Choose by the listener's gender, age and relationship to the speaker.",
      "examples": [
        {
          "vi": "Chào ông.",
          "en": "Hello, sir."
        },
        {
          "vi": "Chào em.",
          "en": "Hello (to a younger person)."
        }
      ],
      "note": "Người nói tự xưng “tôi” khi lịch sự, trung tính."
    },
    {
      "pattern": "S + (có) + adj/verb + không?",
      "explainVi": "Câu hỏi có/không. Có thể bỏ “có”.",
      "explainEn": "Yes/No question. “có” can be omitted.",
      "examples": [
        {
          "vi": "Anh có khoẻ không?",
          "en": "How are you?"
        },
        {
          "vi": "Chị khoẻ không?",
          "en": "How are you?"
        },
        {
          "vi": "– Cám ơn, tôi khoẻ. / – Tôi không khoẻ.",
          "en": "– Thanks, I'm fine. / – I'm not well."
        }
      ],
      "note": ""
    }
  ],
  "dialogues": [
    {
      "title": "Gặp nhau ở lớp học tiếng Việt",
      "titleEn": "Meeting in a Vietnamese class",
      "lines": [
        {
          "speaker": "Minh",
          "vi": "Chào chị. Xin lỗi, chị tên là gì?",
          "en": "Hello. Excuse me, what is your name?"
        },
        {
          "speaker": "Anna",
          "vi": "Chào anh. Tôi tên là Anna. Còn anh?",
          "en": "Hello. My name is Anna. And you?"
        },
        {
          "speaker": "Minh",
          "vi": "Tôi tên là Minh. Rất vui được gặp chị.",
          "en": "My name is Minh. Very nice to meet you."
        },
        {
          "speaker": "Anna",
          "vi": "Rất vui được gặp anh.",
          "en": "Very nice to meet you too."
        }
      ]
    },
    {
      "title": "Gặp lại thầy giáo",
      "titleEn": "Meeting the teacher again",
      "lines": [
        {
          "speaker": "Peter",
          "vi": "Chào thầy ạ. Thầy có khoẻ không ạ?",
          "en": "Hello, teacher. How are you?"
        },
        {
          "speaker": "Thầy Hùng",
          "vi": "Chào em. Cám ơn em, thầy khoẻ. Còn em?",
          "en": "Hello. Thank you, I'm fine. And you?"
        },
        {
          "speaker": "Peter",
          "vi": "Dạ, em cũng khoẻ. Cám ơn thầy.",
          "en": "I'm fine too. Thank you."
        },
        {
          "speaker": "Thầy Hùng",
          "vi": "Chào em. Hẹn gặp lại.",
          "en": "Goodbye. See you again."
        },
        {
          "speaker": "Peter",
          "vi": "Dạ, chào thầy. Hẹn gặp lại thầy.",
          "en": "Goodbye, teacher. See you again."
        }
      ]
    }
