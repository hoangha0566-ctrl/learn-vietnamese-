  "grammar": [
    {
      "pattern": "đi bằng + phương tiện",
      "explainVi": "Hỏi: … nên đi bằng gì? / Đi bằng … mất bao lâu?",
      "explainEn": "Ask: How should … go? / How long does it take by …?",
      "examples": [
        {
          "vi": "Tôi nên đi bằng gì?",
          "en": "How should I go?"
        },
        {
          "vi": "Đi bằng xe lửa mất khoảng 9 tiếng.",
          "en": "By train it takes about 9 hours."
        }
      ],
      "note": ""
    },
    {
      "pattern": "N + nào?",
      "explainVi": "“Nào” đứng sau danh từ, hỏi để chọn lựa.",
      "explainEn": "“nào” after a noun asks for a choice.",
      "examples": [
        {
          "vi": "Anh muốn đi ngày nào?",
          "en": "Which day do you want to go?"
        },
        {
          "vi": "Chị biết người nào trong lớp này?",
          "en": "Which person in this class do you know?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "… vậy?",
      "explainVi": "Trợ từ cuối câu, hỏi rõ hơn về điều đang nói.",
      "explainEn": "Final particle to ask more clearly about the topic.",
      "examples": [
        {
          "vi": "Tất cả bao nhiêu tiền vậy, cô?",
          "en": "So how much altogether?"
        },
        {
          "vi": "Ga Sài Gòn ở đâu vậy?",
          "en": "Where's Saigon station, then?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "(chỉ) … thôi",
      "explainVi": "Nhấn mạnh sự giới hạn; thường đi với “chỉ”.",
      "explainEn": "Stresses a limit; often with “chỉ”.",
      "examples": [
        {
          "vi": "Còn 1 cây số nữa thôi.",
          "en": "Just one more kilometre."
        },
        {
          "vi": "Tôi chỉ đi ngày mai thôi.",
          "en": "I'm only going tomorrow."
        }
      ],
      "note": ""
    },
    {
      "pattern": "Nếu … thì …",
      "explainVi": "Quan hệ điều kiện – kết quả.",
      "explainEn": "Condition – result.",
      "examples": [
        {
          "vi": "Nếu đi bằng máy bay thì chỉ mất 1 tiếng.",
          "en": "If you fly, it only takes an hour."
