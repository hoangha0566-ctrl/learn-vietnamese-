  "dialogues": [
    {
      "title": "Đi Đà Nẵng bằng gì?",
      "titleEn": "How to get to Đà Nẵng?",
      "lines": [
        {
          "speaker": "Lucas",
          "vi": "Chị Hà ơi, tôi muốn đi Đà Nẵng. Theo chị, tôi nên đi bằng gì?",
          "en": "Hà, I want to go to Đà Nẵng. How should I go?"
        },
        {
          "speaker": "Hà",
          "vi": "Anh có thể đi bằng máy bay hay xe lửa.",
          "en": "You can go by plane or by train."
        },
        {
          "speaker": "Lucas",
          "vi": "Đi bằng máy bay mất bao lâu?",
          "en": "How long does it take by plane?"
        },
        {
          "speaker": "Hà",
          "vi": "Nếu đi bằng máy bay thì chỉ mất khoảng 1 tiếng thôi. Còn xe lửa thì mất khoảng 16 tiếng.",
          "en": "By plane only about an hour. By train about 16 hours."
        },
        {
          "speaker": "Lucas",
          "vi": "Xa quá! Tôi đi máy bay.",
          "en": "So far! I'll fly."
        }
      ]
    },
    {
      "title": "Ở quầy bán vé",
      "titleEn": "At the ticket counter",
      "lines": [
        {
          "speaker": "Lucas",
          "vi": "Chào chị. Tôi muốn mua một vé xe lửa đi Huế.",
          "en": "Hello. I'd like a train ticket to Huế."
        },
        {
          "speaker": "Người bán vé",
          "vi": "Anh muốn đi ngày nào?",
          "en": "Which day?"
        },
        {
          "speaker": "Lucas",
          "vi": "Thứ bảy này. Có mấy chuyến vậy, chị?",
          "en": "This Saturday. How many trains are there?"
        },
        {
          "speaker": "Người bán vé",
          "vi": "Có hai chuyến: chuyến sáng và chuyến tối. Anh muốn đi chuyến nào?",
          "en": "Two: morning and evening. Which one?"
        },
        {
          "speaker": "Lucas",
          "vi": "Chuyến tối. Vé khứ hồi, vé nằm.",
          "en": "Evening. Return, sleeper."
        },
        {
          "speaker": "Người bán vé",
          "vi": "Dạ, một triệu hai trăm ngàn đồng.",
          "en": "1,200,000 dong."
        }
      ]
    }
  ],
