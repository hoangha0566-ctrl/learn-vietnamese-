  "grammar": [
    {
      "pattern": "S + là người + nước nào?",
      "explainVi": "Hỏi quốc tịch. Trả lời: S + là người + tên nước.",
      "explainEn": "Ask nationality. Answer: S + là người + country.",
      "examples": [
        {
          "vi": "Cô là người nước nào?",
          "en": "Where are you from?"
        },
        {
          "vi": "Tôi là người Nhật.",
          "en": "I'm Japanese."
        }
      ],
      "note": ""
    },
    {
      "pattern": "…, phải không?",
      "explainVi": "Đặt cuối câu để tạo câu hỏi đuôi. Trả lời: Phải/Vâng hoặc Không phải.",
      "explainEn": "Placed at the end to make a tag question. Answer: Phải/Vâng or Không phải.",
      "examples": [
        {
          "vi": "Anh là người Mỹ, phải không?",
          "en": "You're American, aren't you?"
        },
        {
          "vi": "– Dạ, phải. / – Dạ, không phải. Tôi là người Anh.",
          "en": "– Yes. / – No. I'm English."
        }
      ],
      "note": ""
    },
    {
      "pattern": "dạ",
      "explainVi": "Đặt đầu câu trả lời để biểu thị lễ phép.",
      "explainEn": "Placed at the start of an answer to show politeness.",
      "examples": [
        {
          "vi": "Dạ, phải.",
          "en": "Yes (politely)."
        },
        {
          "vi": "Dạ, không phải.",
          "en": "No (politely)."
        }
      ],
      "note": ""
    },
    {
      "pattern": "Đại từ ngôi thứ ba: anh/chị/ông/bà/cô + ấy",
      "explainVi": "Thêm “ấy” sau đại từ ngôi thứ hai. Số nhiều: thêm “các” phía trước.",
      "explainEn": "Add “ấy” after the 2nd-person pronoun. Plural: add “các” in front.",
      "examples": [
        {
          "vi": "Anh ấy là người Anh.",
          "en": "He is English."
        },
        {
          "vi": "Các chị ấy là người Úc.",
          "en": "They are Australian."
        }
      ],
      "note": ""
    },
    {
      "pattern": "A …, còn B …",
      "explainVi": "“Còn” nêu một trường hợp khác để so sánh.",
      "explainEn": "“Còn” introduces a contrasting case.",
      "examples": [
        {
          "vi": "Tôi là người Việt. Còn anh?",
          "en": "I'm Vietnamese. And you?"
        },
        {
          "vi": "Jane là người Mỹ, còn Marie là người Pháp.",
          "en": "Jane is American, and Marie is French."
        }
      ],
      "note": ""
    },
    {
      "pattern": "đây / đó (đấy) / kia",
      "explainVi": "Đây: gần cả hai người. Đó/đấy: xa người nói, gần người nghe. Kia: xa cả hai.",
      "explainEn": "Đây: near both. Đó/đấy: near the listener. Kia: far from both.",
      "examples": [
        {
          "vi": "Đây là anh Tom.",
          "en": "This is Tom."
        },
        {
          "vi": "Kia là chị Marie.",
          "en": "That (over there) is Marie."
        }
      ],
      "note": ""
    }
