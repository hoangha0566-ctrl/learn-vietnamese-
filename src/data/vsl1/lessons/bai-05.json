  "grammar": [
    {
      "pattern": "Bây giờ là mấy giờ? – … giờ (… phút)",
      "explainVi": "Nói giờ: 7 giờ, 7 giờ 15, 7 giờ rưỡi, 8 giờ kém 10, 9 giờ đúng.",
      "explainEn": "Telling time: 7:00, 7:15, 7:30, 7:50 (8 minus 10), 9:00 sharp.",
      "examples": [
        {
          "vi": "Bây giờ là 10 giờ rưỡi.",
          "en": "It's 10:30 now."
        },
        {
          "vi": "Bây giờ là 3 giờ kém 15.",
          "en": "It's quarter to three."
        }
      ],
      "note": ""
    },
    {
      "pattern": "Buổi trong ngày",
      "explainVi": "Sáng: 1–10 giờ. Trưa: 11–12 giờ. Chiều: 13–18 giờ. Tối: 19–22 giờ. Đêm: 23–24 giờ.",
      "explainEn": "Morning 1–10, noon 11–12, afternoon 13–18, evening 19–22, night 23–24.",
      "examples": [
        {
          "vi": "Máy bay đến lúc 12 giờ trưa.",
          "en": "The plane arrives at 12 noon."
        },
        {
          "vi": "Tôi đi ngủ lúc 11 giờ đêm.",
          "en": "I go to bed at 11 p.m."
        }
      ],
      "note": ""
    },
    {
      "pattern": "S + thường + V",
      "explainVi": "Diễn tả hành động lặp lại thường xuyên. Phủ định: thường không / ít khi.",
      "explainEn": "A regularly repeated action. Negative: thường không / ít khi.",
      "examples": [
        {
          "vi": "Anh thường đi làm lúc mấy giờ?",
          "en": "What time do you usually go to work?"
        },
        {
          "vi": "Tôi ít khi đọc sách.",
          "en": "I rarely read books."
        }
      ],
      "note": ""
    },
    {
      "pattern": "bao nhiêu",
      "explainVi": "Hỏi số lượng mà người nói không biết nhiều hay ít; hỏi giá tiền.",
      "explainEn": "Asks about a quantity of unknown size; asks prices.",
      "examples": [
        {
          "vi": "Lớp cô có bao nhiêu người?",
          "en": "How many people are in your class?"
        },
        {
          "vi": "Cái này bao nhiêu tiền?",
          "en": "How much is this?"
        }
      ],
      "note": ""
    },
    {
      "pattern": "rất + adj",
      "explainVi": "Mức độ cao, dùng trong câu trần thuật.",
      "explainEn": "High degree, used in statements.",
      "examples": [
        {
          "vi": "Cô ấy nói tiếng Việt rất giỏi.",
          "en": "She speaks Vietnamese very well."
