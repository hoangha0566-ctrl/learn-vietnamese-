  "dialogues": [
    {
      "title": "Ở quán phở",
      "titleEn": "At a phở restaurant",
      "lines": [
        {
          "speaker": "Phục vụ",
          "vi": "Dạ, hai chị dùng gì ạ?",
          "en": "What would you like?"
        },
        {
          "speaker": "Linh",
          "vi": "Chị cho tôi xem thực đơn.",
          "en": "Let me see the menu, please."
        },
        {
          "speaker": "Linh",
          "vi": "Julia, chị gọi món nhé!",
          "en": "Julia, you order, OK?"
        },
        {
          "speaker": "Julia",
          "vi": "Ồ, không. Tôi không biết gì về món ăn Việt Nam cả. Món gì tôi cũng ăn được.",
          "en": "Oh no. I don't know anything about Vietnamese food. I can eat anything."
        },
        {
          "speaker": "Linh",
          "vi": "Thôi, được. Cho tôi hai tô phở bò và một đĩa chả giò.",
          "en": "OK then. Two beef phở and a plate of spring rolls."
        },
        {
          "speaker": "Phục vụ",
          "vi": "Dạ. Hai chị uống gì ạ?",
          "en": "And to drink?"
        },
        {
          "speaker": "Julia",
          "vi": "Cho tôi một ly nước dừa. Linh uống gì?",
          "en": "A coconut water for me. What about you, Linh?"
        },
        {
          "speaker": "Linh",
          "vi": "Tôi cũng vậy.",
          "en": "Same for me."
        }
      ]
    },
    {
      "title": "Ở quán cà phê",
      "titleEn": "At a café",
      "lines": [
        {
          "speaker": "Phục vụ",
          "vi": "Anh uống gì ạ?",
          "en": "What would you like to drink?"
        },
        {
          "speaker": "Leo",
          "vi": "Cho tôi một ly cà phê sữa đá. Một ly bao nhiêu tiền?",
          "en": "An iced milk coffee. How much is it?"
        },
        {
          "speaker": "Phục vụ",
          "vi": "Dạ, ba mươi lăm ngàn.",
          "en": "35,000."
        },
        {
          "speaker": "Leo",
          "vi": "Ba mươi lăm ngàn hả? Không đắt lắm.",
          "en": "35,000? Not too expensive."
        },
        {
          "speaker": "Leo",
          "vi": "Em ơi, tính tiền!",
          "en": "Excuse me, the bill please!"
        }
      ]
    }
