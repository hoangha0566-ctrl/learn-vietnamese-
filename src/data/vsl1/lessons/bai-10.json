  "dialogues": [
    {
      "title": "Trên xe lửa",
      "titleEn": "On the train",
      "lines": [
        {
          "speaker": "Vy",
          "vi": "Gia đình anh có mấy người?",
          "en": "How many people are in your family?"
        },
        {
          "speaker": "Mark",
          "vi": "Có bốn người: bố mẹ tôi, tôi và em gái tôi.",
          "en": "Four: my parents, me and my younger sister."
        },
        {
          "speaker": "Vy",
          "vi": "Em gái anh làm gì?",
          "en": "What does your sister do?"
        },
        {
          "speaker": "Mark",
          "vi": "Em ấy còn đi học. Em ấy là sinh viên năm thứ nhất.",
          "en": "She's still studying. She's a first-year student."
        },
        {
          "speaker": "Vy",
          "vi": "Anh đã có gia đình chưa?",
          "en": "Are you married?"
        },
        {
          "speaker": "Mark",
          "vi": "Chưa. Tôi còn độc thân. Còn chị?",
          "en": "No, I'm still single. And you?"
        },
        {
          "speaker": "Vy",
          "vi": "Tôi có gia đình rồi. Tôi có một con trai.",
          "en": "I'm married. I have a son."
        }
      ]
    },
    {
      "title": "Bạn học cũ",
      "titleEn": "Old classmates",
      "lines": [
        {
          "speaker": "Hải",
          "vi": "Chào Bình. Lâu quá không gặp! Anh có gặp chị Lan không?",
          "en": "Hi Bình. Long time no see! Do you see Lan?"
        },
        {
          "speaker": "Bình",
          "vi": "Có. Ngày nào tôi cũng gặp chị ấy. Chúng tôi cùng làm việc ở bưu điện.",
          "en": "Yes, every day. We work at the post office together."
        },
        {
          "speaker": "Hải",
          "vi": "Chị ấy đã có gia đình chưa?",
          "en": "Is she married?"
        },
        {
          "speaker": "Bình",
          "vi": "Rồi. Chị ấy có gia đình rồi.",
          "en": "Yes, she is."
        },
        {
          "speaker": "Hải",
          "vi": "Vậy hả? Thôi, chúng ta đi uống cà phê đi!",
          "en": "Really? Well, let's go for a coffee!"
        }
      ]
    }
  ],
