  "grammar": [
    {
      "pattern": "Gia đình + có mấy người?",
      "explainVi": "Hỏi số người trong gia đình; trả lời liệt kê: ba má tôi, tôi và …",
      "explainEn": "Ask family size; answer by listing: my parents, me and …",
      "examples": [
        {
          "vi": "Gia đình chị có mấy người? – Có 5 người: ba má tôi, tôi và hai em trai.",
          "en": "How many in your family? – Five: my parents, me and two younger brothers."
        }
      ],
      "note": ""
    },
    {
      "pattern": "(đã) + V + chưa?",
      "explainVi": "Hỏi việc đã xảy ra chưa. Trả lời: Rồi, … rồi. / Chưa, … chưa …",
      "explainEn": "Asks whether something has happened yet. Answer: Rồi … rồi / Chưa … chưa …",
      "examples": [
        {
          "vi": "Cô đã ăn cơm chưa? – Rồi, tôi ăn rồi.",
          "en": "Have you eaten? – Yes, I have."
        },
        {
          "vi": "Anh ấy có gia đình chưa? – Chưa, anh ấy còn độc thân.",
          "en": "Is he married? – No, he's still single."
        }
      ],
      "note": ""
    },
    {
      "pattern": "N + nào + (S) + cũng + V/adj",
      "explainVi": "Mọi đơn vị trong nhóm đều giống nhau.",
      "explainEn": "Every member of the group is the same.",
      "examples": [
        {
          "vi": "Ngày nào chúng tôi cũng gặp nhau.",
          "en": "We meet every day."
        },
        {
          "vi": "Người nào cũng dễ thương.",
          "en": "Everyone is lovely."
        }
      ],
      "note": ""
    },
    {
      "pattern": "cùng + V",
      "explainVi": "Cùng làm một việc, ở cùng một nơi.",
      "explainEn": "Doing the same thing / in the same place.",
      "examples": [
        {
          "vi": "Họ cùng làm việc ở một công ty.",
          "en": "They work at the same company."
        }
      ],
      "note": ""
    },
    {
      "pattern": "còn + V/adj",
      "explainVi": "Trạng thái vẫn đang tiếp tục.",
      "explainEn": "A state that is still continuing.",
      "examples": [
        {
          "vi": "Hai em tôi còn đi học.",
          "en": "My two siblings are still at school."
        },
        {
          "vi": "Nó còn ngủ.",
          "en": "He's still asleep."
        }
      ],
      "note": ""
    },
    {
      "pattern": "chúng tôi vs chúng ta",
      "explainVi": "“Chúng tôi” không gồm người nghe; “chúng ta” gồm cả người nghe.",
      "explainEn": "“chúng tôi” excludes the listener; “chúng ta” includes them.",
      "examples": [
